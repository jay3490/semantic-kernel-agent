{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Api": {
    "MaxChatRequestBytes": 65536
  },
  "Auth": {
    "ApiKeys": []
  },
  "Telemetry": {
    "ServiceName": "devops-agent-api",
    "SemanticKernelModelDiagnostics": true,
    "PrometheusEndpoint": "/metrics"
  },
  "RateLimiting": {
    "PermitsPerMinute": 60,
    "Burst": 20
  },
  "ChatModel": {
    "ModelId": "gpt-4o-mini",
    "Endpoint": "",
    "ApiKey": ""
  },
  "Embeddings": {
    "ModelId": "",
    "Endpoint": "",
    "ApiKey": ""
  },
  "Agent": {
    "HistoryTokenBudget": 8000,
    "MaxToolRounds": 5,
    "MaxSessions": 500,
    "MaxMessageCharacters": 16000,
    "AllowedTools": [ "kubernetes.*", "dockerfile.*", "helm.*", "terraform.*", "github_actions.*", "logs.*", "runbooks.*", "time.*" ],
    "ReviewLintAnswers": false
  },
  "Workspace": {
    "Root": ".",
    "MaxFileBytes": 1048576
  },
  "Runbooks": {
    "Directory": "samples/runbooks",
    "MinSimilarity": 0.3
  },
  "Sessions": {
    "Provider": "Memory",
    "ConnectionString": "Data Source=sessions.db",
    "Ttl": "1.00:00:00",
    "CleanupInterval": "00:10:00"
  }
}
