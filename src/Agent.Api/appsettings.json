{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ChatModel": {
    "ModelId": "gpt-4o-mini",
    "Endpoint": "",
    "ApiKey": ""
  },
  "Agent": {
    "HistoryTokenBudget": 8000,
    "MaxToolRounds": 5,
    "MaxSessions": 500,
    "AllowedTools": [ "kubernetes.*", "dockerfile.*", "helm.*", "terraform.*", "github_actions.*", "logs.*", "time.*" ]
  },
  "Workspace": {
    "Root": ".",
    "MaxFileBytes": 1048576
  },
  "Sessions": {
    "Provider": "Memory",
    "ConnectionString": "Data Source=sessions.db"
  }
}
